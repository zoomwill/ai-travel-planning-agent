APP_NAME=ai-travel-planner
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=travel
POSTGRES_PASSWORD=travel_dev_only
POSTGRES_DB=travel_planner
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_SSL=false

INFRASTRUCTURE_TIMEOUT_SECONDS=2.0

# Deterministic Planner–Reviewer loop safety settings.
REVIEW_SCORE_THRESHOLD=80
REVIEW_MAX_ROUNDS=3
GRAPH_RECURSION_LIMIT=50

# Keep LangGraph checkpoint deserialization on the schema-derived safe allowlist.
LANGGRAPH_STRICT_MSGPACK=true

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-travel-planner
