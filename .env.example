APP_NAME=ai-travel-planner
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=travel
POSTGRES_PASSWORD=travel_dev_only
POSTGRES_DB=travel_planner
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_SSL=false

INFRASTRUCTURE_TIMEOUT_SECONDS=2.0

# P17: demo forces all five kinds offline. external uses per-kind selectors.
# Legacy duffel still means Duffel Flights + optional Duffel Stays, NOT LiteAPI.
TRAVEL_DATA_MODE=demo
TRAVEL_FLIGHT_PROVIDER=duffel
TRAVEL_HOTEL_PROVIDER=liteapi
LITEAPI_ENV=sandbox
LITEAPI_API_KEY=
LITEAPI_TIMEOUT_SECONDS=20
LITEAPI_MAX_RETRIES=1
LITEAPI_MAX_HOTELS=10
LITEAPI_MAX_RATES_PER_HOTEL=1
LITEAPI_ALLOW_DEMO_FALLBACK=false
DUFFEL_ENV=test
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_TIMEOUT_SECONDS=20
DUFFEL_MAX_RETRIES=1
DUFFEL_MAX_FLIGHT_OFFERS=5
DUFFEL_MAX_STAY_RESULTS=10
DUFFEL_ALLOW_DEMO_FALLBACK=false

# P11 local MCP travel tools. Keep direct as the beginner-safe default.
TRAVEL_SEARCH_BACKEND_MODE=direct
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=9001
MCP_HTTP_PATH=/mcp
MCP_HTTP_URL=http://127.0.0.1:9001/mcp
MCP_TOOL_TIMEOUT_SECONDS=8.0
MCP_DISCOVERY_TIMEOUT_SECONDS=15.0
MCP_MAX_RETRIES=1
MCP_REQUIRE_ALL_TOOLS=true
MCP_ENABLE_STDIO_SERVER=true
MCP_ENABLE_HTTP_SERVER=true

# Deterministic Planner–Reviewer loop safety settings.
REVIEW_SCORE_THRESHOLD=80
REVIEW_MAX_ROUNDS=3
GRAPH_RECURSION_LIMIT=50

# P12 SSE transport controls. Heartbeats are comments, not business events.
# Keep this below FastAPI 0.141.1's fixed 15-second fallback keepalive.
SSE_HEARTBEAT_SECONDS=10
SSE_QUEUE_MAXSIZE=64

# P15 keeps only this many redacted user-visible intake messages.
INTAKE_HISTORY_LIMIT=30

# P10 versioned local hybrid RAG. Model preparation remains an explicit command.
RAG_PIPELINE_VERSION=advanced-v1
RAG_CHILD_COLLECTION=travel_knowledge_children_v1
RAG_EMBEDDING_BACKEND=sentence_transformers
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_NORMALIZE=true
RAG_PARENT_CHUNK_SIZE=1200
RAG_PARENT_CHUNK_OVERLAP=150
RAG_CHILD_CHUNK_SIZE=350
RAG_CHILD_CHUNK_OVERLAP=50
RAG_QUERY_VARIANT_COUNT=4
RAG_DENSE_TOP_K=20
RAG_SPARSE_TOP_K=20
RAG_FUSION_TOP_K=20
RAG_RERANK_TOP_K=8
RAG_FINAL_PARENT_K=4
RAG_RRF_K=60
RAG_CACHE_TTL_SECONDS=3600
RAG_ENABLE_CACHE=true
RAG_METADATA_FILTER_FALLBACK=true

# Keep LangGraph checkpoint deserialization on the schema-derived safe allowlist.
LANGGRAPH_STRICT_MSGPACK=true

# P14 optional Qwen reasoning. Deterministic remains the no-cost default.
AGENT_REASONING_MODE=deterministic
QWEN_API_KEY=
# Alternatively set DASHSCOPE_API_KEY instead of QWEN_API_KEY.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=1
QWEN_MAX_COMPLETION_TOKENS=2048
QWEN_TEMPERATURE=0.2
QWEN_ENABLE_THINKING=false
QWEN_ALLOW_DETERMINISTIC_FALLBACK=false

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-travel-planner

# P18: local demo stays account-free. Production must use auth0.
AUTH_MODE=demo
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH_JWKS_CACHE_TTL_SECONDS=3600
AUTH_JWKS_TIMEOUT_SECONDS=5
AUTH_RATE_INTAKE_PER_MINUTE=10
AUTH_RATE_INTAKE_PER_DAY=50
AUTH_RATE_GLOBAL_INTAKE_PER_DAY=200
AUTH_RATE_PLAN_PER_DAY=3
AUTH_RATE_GLOBAL_PLAN_PER_DAY=20
API_DOCS_ENABLED=true
METRICS_ENABLED=true
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
TRUSTED_HOSTS=["127.0.0.1","localhost","testserver"]
# Backend-only Railway Redis credentials; local Docker Redis has no password.
REDIS_PASSWORD=
REDIS_SSL=false
# Optional REDIS_USERNAME for an ACL user. Do not set an empty username.
# Container builds pin this same P10 model revision; no runtime/request download.
# RAG_EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
